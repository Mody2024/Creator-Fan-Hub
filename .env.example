# Copy to .env.local for local development. Never commit real credentials.
# Only the public Supabase project URL and publishable key are needed by this app.
# Database access is protected by RLS and guarded SECURITY DEFINER RPCs.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Raye2 group voice SFU (LiveKit). Keep API secrets server-side only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
