# Copy to .env.local for local development. Never commit real credentials.
# The app must fail safely when these values are missing.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to browser code.
SUPABASE_SECRET_KEY=

# Configure a long, random secret in Vercel's protected environment settings.
# Do not reuse your account password or commit a real value.
ADMIN_SESSION_SECRET=

# UUID of the single authorized creator account, verified server-side.
# Set only after creating the dedicated Supabase Auth user.
ADMIN_USER_ID=
