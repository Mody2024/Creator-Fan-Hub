# Copy to .env.local for local development. Never commit real credentials.
# Only the public Supabase project URL and publishable key are needed by this app.
# Database access is protected by RLS and guarded SECURITY DEFINER RPCs.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Raye2 group voice SFU (LiveKit). Keep API secrets server-side only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional Coturn REST credentials for private-call TURN relay. Keep the shared secret server-side.
RAYE2_TURN_URLS=
RAYE2_TURN_SHARED_SECRET=


# Optional S3-compatible object storage. Configure only after creating provider buckets
# and least-privilege application keys. Secrets must never use NEXT_PUBLIC_ prefixes.
# R2 endpoint may be derived from ACCOUNT_ID; B2 requires its S3 endpoint and region.
RAYE2_R2_ACCOUNT_ID=
RAYE2_R2_ENDPOINT=
RAYE2_R2_REGION=auto
RAYE2_R2_ACCESS_KEY_ID=
RAYE2_R2_SECRET_ACCESS_KEY=
RAYE2_R2_PUBLIC_BUCKET=
RAYE2_R2_PRIVATE_BUCKET=
RAYE2_R2_PUBLIC_BASE_URL=

RAYE2_B2_ENDPOINT=
RAYE2_B2_REGION=
RAYE2_B2_ACCESS_KEY_ID=
RAYE2_B2_SECRET_ACCESS_KEY=
RAYE2_B2_PUBLIC_BUCKET=
RAYE2_B2_PRIVATE_BUCKET=
RAYE2_B2_PUBLIC_BASE_URL=

# Additional S3-compatible providers and extra accounts are pooled automatically. Name the block
# RAYE2_<FAMILY>[_<ACCOUNT>]_*: the base block (RAYE2_TIGRIS_*) is account #1, and a suffix adds
# another account of the same provider (RAYE2_B2_ACCOUNT2_*). Known families with preset endpoints
# (tigris, filebase, storj, wasabi, idrive, scaleway, linode, aws) may omit _ENDPOINT/_REGION.
# Any other family works when it sets an explicit _ENDPOINT. Admin → Providers shows every pool.
# Tigris (free 5 GB/mo, no card): endpoint https://t3.storage.dev, region auto.
RAYE2_TIGRIS_ACCESS_KEY_ID=
RAYE2_TIGRIS_SECRET_ACCESS_KEY=
RAYE2_TIGRIS_PUBLIC_BUCKET=
RAYE2_TIGRIS_PRIVATE_BUCKET=
RAYE2_TIGRIS_PUBLIC_BASE_URL=
# Filebase (free 5 GB pooled, no card): endpoint https://s3.filebase.com, region us-east-1.
RAYE2_FILEBASE_ACCESS_KEY_ID=
RAYE2_FILEBASE_SECRET_ACCESS_KEY=
RAYE2_FILEBASE_PUBLIC_BUCKET=
RAYE2_FILEBASE_PRIVATE_BUCKET=
RAYE2_FILEBASE_PUBLIC_BASE_URL=
# Storj (free 25 GB for 30 days): endpoint https://gateway.storjshare.io, region us-east-1.
RAYE2_STORJ_ACCESS_KEY_ID=
RAYE2_STORJ_SECRET_ACCESS_KEY=
RAYE2_STORJ_PUBLIC_BUCKET=
RAYE2_STORJ_PRIVATE_BUCKET=
RAYE2_STORJ_PUBLIC_BASE_URL=
# A second Backblaze account (free 10 GB each). Backblaze needs its per-region S3 endpoint.
RAYE2_B2_ACCOUNT2_ENDPOINT=
RAYE2_B2_ACCOUNT2_REGION=
RAYE2_B2_ACCOUNT2_ACCESS_KEY_ID=
RAYE2_B2_ACCOUNT2_SECRET_ACCESS_KEY=
RAYE2_B2_ACCOUNT2_PUBLIC_BUCKET=
RAYE2_B2_ACCOUNT2_PRIVATE_BUCKET=
RAYE2_B2_ACCOUNT2_PUBLIC_BASE_URL=

# Bring-your-own storage (BYOS). A contributor connects a bucket from the Account page and names
# the secret reference below; the actual credentials stay in this server-only environment block.
# Only a trusted server reads these to probe the connection. Public delivery never uses BYOS.
RAYE2_BYOS_STORJ_ACCESS_KEY_ID=
RAYE2_BYOS_STORJ_SECRET_ACCESS_KEY=

